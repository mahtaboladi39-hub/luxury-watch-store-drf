DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=

DB_NAME=watch_store
DB_USER=watch_store
DB_PASSWORD=watch_store
DB_HOST=127.0.0.1
DB_PORT=5432

